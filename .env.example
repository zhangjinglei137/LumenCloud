# Database — 指向你的 PostgreSQL
POSTGRES_USER=lumen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lumencloud
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/lumencloud

# Redis
REDIS_URL=redis://host:6379/0

# JWT — 用 openssl rand -hex 32 生成
JWT_SECRET=change_me_to_random_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Emby
EMBY_BASE_URL=http://your-emby-host:8096
EMBY_API_KEY=your_emby_api_key

# CloudSaver
CLOUDSAVER_BASE_URL=http://your-cloudsaver-host:8008
CLOUDSAVER_USERNAME=admin
CLOUDSAVER_PASSWORD=your_password

# Aria2
ARIA2_RPC_URL=http://your-aria2-host:6800/jsonrpc
ARIA2_SECRET=your_aria2_token
ARIA2_DOWNLOAD_DIR=/downloads

# NasTools
NASTOOLS_BASE_URL=http://your-nastools-host:3000
NASTOOLS_USERNAME=admin
NASTOOLS_PASSWORD=your_password

# AList
ALIST_BASE_URL=http://your-alist-host:5244
ALIST_TOKEN=your_alist_token

# PushPlus — http://www.pushplus.plus
PUSHPLUS_TOKEN=your_pushplus_token

# App
APP_NAME=LumenCloud
DEBUG=false
