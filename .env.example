# ============================================
# LumenCloud 环境变量说明（Phase 8 配置入库后）
#
# ★ 重要变化（Phase 8）：
#   服务凭据（ALIST/CLOUDSAVER/ARIA2/NASTOOLS/EMBY/TMDB/PUSHPLUS/QUARK）不再
#   需要环境变量 —— 全部通过「设置页 → 服务凭据配置」保存到数据库（system_config），
#   保存即生效、无需重启。
#   JWT_SECRET 不再需要：首次启动自动生成强随机值并落盘 <data_dir>/.jwt_secret。
#   admin 初始密码不再需要：首次启动自动生成随机密码并打印在服务日志，登录后
#   在设置页修改。
#
# 因此 .env 现在是【完全可选】的，仅在需要覆盖默认行为时创建。本文件仅作说明。
# ============================================

# ---------- 数据库（可选） ----------
# 留空 = 内置 SQLite（存于 volume /app/data/lumencloud.db）
DATABASE_URL=
# 如需外部 Postgres：
# DATABASE_URL=postgresql+asyncpg://lumen:password@192.168.3.31:5432/lumencloud

# ---------- 初始化（可选覆盖） ----------
# 默认 admin；首次启动自动生成随机密码并打印在服务日志
INIT_ADMIN_USERNAME=admin

# ---------- 服务凭据（Phase 8 起无需在此配置，全部走设置页入库） ----------
# 以下仅为「曾在 .env 配置」的键位一览，供参考/旧部署迁移：
# TMDB_API_KEY / TMDB_PROXY / EMBY_BASE_URL / EMBY_API_KEY /
# CLOUDSAVER_BASE_URL / CLOUDSAVER_USERNAME / CLOUDSAVER_PASSWORD /
# ALIST_BASE_URL / ALIST_TOKEN / ARIA2_RPC_URL / ARIA2_TOKEN /
# NASTOOLS_BASE_URL / NASTOOLS_USERNAME / NASTOOLS_PASSWORD /
# PUSHPLUS_TOKEN / QUARK_QUOTA_GB / QUARK_DEFAULT_FOLDER
# → 现均可通过「设置页 → 服务凭据配置」入库，保存即生效。
