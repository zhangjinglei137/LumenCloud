# ============================================
# LumenCloud 环境变量说明（Phase 8 配置入库后）
#
# ★ 重要变化（Phase 8）：
#   服务凭据（ALIST/CLOUDSAVER/ARIA2/NASTOOLS/EMBY/TMDB/PUSHPLUS/QUARK）不再
#   需要环境变量 —— 全部通过「设置页 → 服务凭据配置」保存到数据库（system_config），
#   保存即生效、无需重启。
#   JWT_SECRET 不再需要：首次启动自动生成强随机值并落盘 <data_dir>/.jwt_secret。
#   admin 初始密码不再需要：首次启动自动生成随机密码并打印在服务日志，登录后
#   在设置页修改。
#
# 因此 .env 现在是【完全可选】的，仅在需要覆盖默认行为时创建。本文件仅作说明。
# ============================================

# ---------- 数据库（可选） ----------
# 留空 = 内置 SQLite（存于 volume /app/data/lumencloud.db）
DATABASE_URL=
# 如需外部 Postgres：
# DATABASE_URL=postgresql+asyncpg://lumen:password@192.168.3.31:5432/lumencloud

# ---------- compose 数据库密码（docker-compose 部署时使用） ----------
# 仅供 docker compose 变量插值，应用进程不直接读此键。
# 未设置时：
#   - docker-compose.yml（开发）回退默认 lumencloud（仅供本地开发）；
#   - docker-compose.prod.yml（生产）直接报错、拒绝启动（fail-closed）。
# 生产部署必须显式注入强密码，db 与 lumencloud 两处自动取同一值保持同步：
#   POSTGRES_PASSWORD=xxxxxxxx docker compose -f docker-compose.prod.yml up -d
POSTGRES_PASSWORD=

# ---------- CORS（可选） ----------
# 逗号分隔的跨域白名单；留空 = 禁用 CORS（同源部署推荐）。
# 默认值含开发端口 5173（vite dev server），示例：
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://media.example.com

# ---------- 启动行为（可选） ----------
# AUTO_MIGRATE：默认 1，启动时自动 alembic 迁移建表。生产若需手动控制迁移
#   步骤，设 AUTO_MIGRATE=0 并先手动执行 alembic upgrade head（backend/alembic）。
# AUTO_MIGRATE=0
# COOKIE_SECURE：认证 Cookie 仅经 HTTPS 发送。仅当 HTTPS 反向代理部署时设 1；
#   本地 http 部署保持默认 0，否则浏览器会丢弃 Cookie 导致无法保持登录。
# COOKIE_SECURE=1
# LOGIN_FAIL_LIMIT / LOGIN_FAIL_WINDOW_SECONDS：登录失败限流——窗口内连续失败
#   达到上限即临时锁定，按需调阈值。
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=300

# ---------- 初始化（可选覆盖） ----------
# 默认 admin；首次启动自动生成随机密码并打印在服务日志
INIT_ADMIN_USERNAME=admin

# ---------- 服务凭据（Phase 8 起无需在此配置，全部走设置页入库） ----------
# 以下仅为「曾在 .env 配置」的键位一览，供参考/旧部署迁移：
# TMDB_API_KEY / TMDB_PROXY / EMBY_BASE_URL / EMBY_API_KEY /
# CLOUDSAVER_BASE_URL / CLOUDSAVER_USERNAME / CLOUDSAVER_PASSWORD /
# ALIST_BASE_URL / ALIST_TOKEN / ARIA2_RPC_URL / ARIA2_TOKEN /
# NASTOOLS_BASE_URL / NASTOOLS_USERNAME / NASTOOLS_PASSWORD /
# PUSHPLUS_TOKEN / QUARK_QUOTA_GB / QUARK_DEFAULT_FOLDER
# → 现均可通过「设置页 → 服务凭据配置」入库，保存即生效。
