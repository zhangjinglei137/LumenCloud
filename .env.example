# ============================================
# LumenCloud 环境变量示例
# 复制为 .env（开发）或 .env.prod（生产）后填写
# 敏感凭据全部走环境变量，不进入数据库
# ============================================

# ---------- 数据库 ----------
# 留空 = 内置 SQLite（存于 volume /app/data）
DATABASE_URL=
# 如需外部 Postgres：
# DATABASE_URL=postgresql+asyncpg://lumen:password@192.168.3.31:5432/lumencloud

# ---------- 初始化 ----------
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change_me
JWT_SECRET=           # 必填，建议随机 32 字节 hex

# ---------- TMDB ----------
TMDB_API_KEY=
TMDB_PROXY=           # 可选，如 https://tmdb-proxy.example.com

# ---------- Emby（防重基线 + 已有集） ----------
EMBY_BASE_URL=http://192.168.3.31:8096
EMBY_API_KEY=

# ---------- CloudSaver（网盘搜索/分享码/转存） ----------
CLOUDSAVER_BASE_URL=http://192.168.3.31:8008
CLOUDSAVER_USERNAME=
CLOUDSAVER_PASSWORD=

# ---------- AList（/quark 挂载 + 直链 + 释放） ----------
ALIST_BASE_URL=http://192.168.3.31:5244
ALIST_TOKEN=

# ---------- Aria2（下载器） ----------
ARIA2_RPC_URL=http://192.168.3.31:6800/jsonrpc
ARIA2_TOKEN=

# ---------- NasTools（目录同步入库） ----------
NASTOOLS_BASE_URL=http://192.168.3.31:3000
NASTOOLS_USERNAME=
NASTOOLS_PASSWORD=

# ---------- PushPlus（可选，通知降级为站内消息） ----------
PUSHPLUS_TOKEN=

# ---------- 容量（夸克中转空间） ----------
QUARK_QUOTA_GB=10